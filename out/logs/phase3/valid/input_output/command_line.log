func main(int argc, str argv[]) : int
    local int i
    local int total
    temp t1:int, t2:str, t3:int, t4:int, t5:int, t6:str, t7:int, t8:str
    temp t9:char, t10:int
    total = 0
    param str0
    call print_str, 1
    param argc
    call print_int, 1
    param str1
    call print_str, 1
    i = 1
L1:
    if i < argc goto L2
    goto L4
L2:
    t1 = i * 4
    t2 = argv[t1]
    param t2
    t3 = call atoi, 1
    t4 = total + t3
    total = t4
    t5 = i * 4
    t6 = argv[t5]
    t7 = i * 4
    t8 = argv[t7]
    t9 = t8[0]
    param str2
    call print_str, 1
    param i
    call print_int, 1
    param str3
    call print_str, 1
    param t6
    call print_str, 1
    param str4
    call print_str, 1
    param t9
    call print_char, 1
    param str1
    call print_str, 1
L3:
    t10 = i + 1
    i = t10
    goto L1
L4:
    param str5
    call print_str, 1
    param total
    call print_int, 1
    param str1
    call print_str, 1
    return 0
endfunc
