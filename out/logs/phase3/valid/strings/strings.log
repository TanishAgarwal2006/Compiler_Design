.text
func count_char(str s, char c) : int
    local int i
    local int n
    temp t1:char, t2:char, t3:int, t4:int
    i = 0
    n = 0
L1:
    t1 = s[i]
    if t1 != 0 goto L2
    goto L3
L2:
    t2 = s[i]
    if t2 == c goto L4
    goto L5
L4:
    t3 = n + 1
    n = t3
L5:
    t4 = i + 1
    i = t4
    goto L1
L3:
    return n
endfunc

func string_literals_main() : int
    local str msg
    local char buf[8]
    temp t1:int, t2:int, t3:char
    msg = str0
    buf[0] = 97
    buf[1] = 112
    buf[2] = 112
    buf[3] = 108
    buf[4] = 101
    buf[5] = 0
    buf[6] = 0
    buf[7] = 0
    param msg
    param 97
    t1 = call count_char, 2
    param buf
    param 112
    t2 = call count_char, 2
    param msg
    call print_str, 1
    param str1
    call print_str, 1
    param t1
    call print_int, 1
    param str1
    call print_str, 1
    param t2
    call print_int, 1
    param str2
    call print_str, 1
    msg = buf
    t3 = msg[0]
    param msg
    call print_str, 1
    param str1
    call print_str, 1
    param t3
    call print_char, 1
    param str2
    call print_str, 1
    return 0
endfunc

func string_variables_main() : int
    local str s
    local str t
    s = str4
    param msg
    call print_str, 1
    param str1
    call print_str, 1
    param s
    call print_str, 1
    param str2
    call print_str, 1
    t = s
    s = str5
    param s
    call print_str, 1
    param str1
    call print_str, 1
    param t
    call print_str, 1
    param str2
    call print_str, 1
    msg = str6
    param msg
    call print_str, 1
    param str2
    call print_str, 1
    return 0
endfunc

func main() : int
    param str7
    call print_str, 1
    call string_literals_main, 0
    param str8
    call print_str, 1
    call string_variables_main, 0
    return 0
endfunc
